# Copie para .env na raiz do projeto:  cp .env.example .env
# O back-end lê ../.env e o docker compose lê .env — um arquivo só, sem duplicação.
# Todos os valores abaixo têm padrão sensato: a aplicação sobe mesmo sem .env.

# ---------- Aplicação ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# ---------- Persistência ----------
# memoria = lê backend/seed/dados.json, não precisa de banco (padrão)
# mysql   = usa o MySQL configurado abaixo (docker compose up)
PERSISTENCIA=memoria

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=gestao_academica
MYSQL_USER=app
MYSQL_PASSWORD=app
MYSQL_ROOT_PASSWORD=root

# ---------- Assistente de IA ----------
# Vazio    = modo demonstrativo com respostas locais; a aplicação sobe normalmente.
# Com chave = integração real com a API da Anthropic.
# NUNCA comite um valor real aqui. O CI falha se encontrar uma chave versionada.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_TIMEOUT_MS=20000
ANTHROPIC_EFFORT=low
